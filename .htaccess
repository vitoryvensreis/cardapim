# Preferir Apache DocumentRoot /caminho/cardapim/public.
# Fallback somente para hosts que apontam para a raiz.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(app|bootstrap|config|database|deploy|dev|docs|realtime|resources|routes|storage|tests|vendor|workers)(/|$) - [F,L,NC]
    RewriteRule ^public/ - [L]
    RewriteRule ^$ public/ [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
