APP_NAME=Cardapim
APP_ENV=production
APP_DEBUG=false
APP_URL=https://cardapim.escotilhaprodutora.com
APP_TIMEZONE=America/Fortaleza
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cardapim
DB_USERNAME=cardapim-user
DB_PASSWORD=
# Preencher o valor privado no arquivo shared/.env da VPS; nunca commitar a senha.
# E-mail (codigo da verificacao em duas etapas). mail = mail() do servidor; log = storage/logs/mail.log (so testes).
MAIL_DRIVER=mail
MAIL_FROM=
# Chave da criptografia de segredos (opcional). Sem ela, storage/keys/app.key e criado na primeira vez.
APP_KEY=
# WhatsApp: WPPConnect proprio do Cardapim (Docker so em 127.0.0.1). Ver docs/deploy/wppconnect-docker.md
WPPCONNECT_BASE_URL=
WPPCONNECT_SECRET_KEY=
# iFood: app DISTRIBUIDO do Cardapim no Portal do Desenvolvedor iFood
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# Asaas: cada restaurante cola a propria chave no painel (nada aqui). Enderecos so mudam em testes.
# ASAAS_URL_PRODUCAO=https://api.asaas.com/v3
# ASAAS_URL_SANDBOX=https://api-sandbox.asaas.com/v3
# Enderecos e mapa SEM custo (cardapio online). Funciona sem configurar nada:
# CEP pela BrasilAPI/ViaCEP; distancia pelo Nominatim (OpenStreetMap), so para areas de entrega por km.
# Politica do Nominatim publico: maximo 1 consulta/s para o site todo (o Cardapim respeita e guarda cache 30 dias).
# GEO_CONTATO = e-mail de contato enviado ao Nominatim (recomendado). GEO_NOMINATIM=0 desliga o Nominatim.
GEO_CONTATO=
# GEO_NOMINATIM=1
# GEO_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Tempo real (WebSocket proprio + Redis). Ver docs/deploy/tempo-real.md
# WS_ATIVO=1 so depois que o servidor (systemd) e o Nginx (/ws) estiverem prontos.
WS_ATIVO=
WS_PORTA=8091
WS_URL=
WS_ORIGENS=
REDIS_HOST=127.0.0.1
REDIS_PORT=
REDIS_PASSWORD=

# Telefone privado para as contas demonstrativas (11 digitos com DDD); configurar so na VPS.
CARDAPIM_TEST_WHATSAPP=
