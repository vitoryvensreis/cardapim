# Cardapim - tempo real (WebSocket) atras do Nginx do CloudPanel.
# Colar DENTRO do server { } do site (CloudPanel > Sites > cardapim > Vhost), antes do "location /".
# O servidor PHP de tempo real escuta so em 127.0.0.1 (porta WS_PORTA do .env, padrao 8091).
location = /ws {
    proxy_pass http://127.0.0.1:8091;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_buffering off;
    access_log off;
}
