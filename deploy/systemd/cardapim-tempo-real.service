# Servidor de tempo real (WebSocket) do Cardapim. Instalar como root:
#   cp deploy/systemd/cardapim-tempo-real.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now cardapim-tempo-real
# Passo a passo completo: docs/deploy/tempo-real.md
[Unit]
Description=Cardapim - servidor de tempo real (WebSocket)
After=network-online.target mysql.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=escotilhaprodutora-cardapim
Group=escotilhaprodutora-cardapim
# "current" aponta para a release ativa. Num deploy novo o servidor percebe a troca, fecha as conexoes
# (os navegadores reconectam sozinhos) e sai; o systemd sobe de novo ja com o codigo novo.
WorkingDirectory=/home/escotilhaprodutora-cardapim/apps/cardapim/current
ExecStart=/usr/bin/php8.4 /home/escotilhaprodutora-cardapim/apps/cardapim/current/bin/tempo-real.php
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
LimitNOFILE=4096
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/escotilhaprodutora-cardapim/apps/cardapim/shared/storage
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
